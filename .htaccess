<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^backend/\.env - [F,L,NC]

    # Rewrite all traffic to backend/public/
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
