# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=WebIntoApp
APP_ENV=local
APP_KEY=                         # run: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webintoapp
DB_USERNAME=wia
DB_PASSWORD=                     # set in docker-compose env or here

# ─── Cache / Queue / Session ──────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false      # set true in production (HTTPS)

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # set to REDIS_PASSWORD in docker env

# ─── Mail (Mailpit for local dev) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@webintoapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,app.webintoapp.com

# ─── Horizon ──────────────────────────────────────────────────────────────────
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# ─── Filament admin ───────────────────────────────────────────────────────────
FILAMENT_AUTH_GUARD=web

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug                  # set to error in production

# ─── Credentials encryption key ───────────────────────────────────────────────
# 32-byte random hex string — used by CredentialVault to encrypt client store keys.
# NEVER commit a real value. Generate with: php -r "echo bin2hex(random_bytes(32));"
CREDENTIAL_VAULT_KEY=            # REQUIRED before first use

# ─── OTP provider ─────────────────────────────────────────────────────────────
OTP_PROVIDER=log                 # options: log (dev), msg91, fast2sms
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase (server-side, for FCM) ─────────────────────────────────────────
# Path to service account JSON — never store content inline in env
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Google OAuth (for social login verification) ─────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=              # leave empty in local

# ─── Storage ──────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# S3-compatible (used in staging/prod for APK artifacts, keystores, assets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=                    # for MinIO / DigitalOcean Spaces

# ─── Build worker ─────────────────────────────────────────────────────────────
BUILD_WORKER_TYPE=local          # options: local, ci
BUILD_TIMEOUT_SECONDS=1800       # 30 min
BUILD_CONCURRENCY_PER_TENANT=1
